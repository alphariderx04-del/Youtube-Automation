# OpenAI API key (https://platform.openai.com/api-keys se lo)
OPENAI_API_KEY=your_openai_api_key_here

# Video/channel ke baare me AI ko context dene ke liye (optional but recommended)
CHANNEL_NICHE=e.g. Tech reviews, cooking, gaming, motivation etc.
CHANNEL_TONE=e.g. Casual and funny / Professional / Energetic

# Default upload settings
DEFAULT_PRIVACY_STATUS=private
# options: private, public, unlisted
DEFAULT_CATEGORY_ID=22
# 22 = People & Blogs. Full list: https://developers.google.com/youtube/v3/docs/videoCategories/list

# Kitni der baad publish karna hai upload ke (minutes). 0 = turant publish
SCHEDULE_DELAY_MINUTES=0

# Folder jaha aap naya video + thumbnail daalenge
WATCH_FOLDER=./videos_to_upload
